class Tee:
    def __init__(self, *streams):
        self.streams = streams

    def write(self, data):
        for stream in self.streams:
            stream.write(data)
            stream.flush()
        return len(data)

    def flush(self):
        for stream in self.streams:
            stream.flush()

    @property
    def encoding(self):
        return "utf-8"

    def close(self):
        self.flush()


def _shell_join(parts: Sequence[object]) -> str:
    return " ".join(shlex.quote(str(p)) for p in parts if p is not None)


