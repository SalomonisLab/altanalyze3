manifest {
    name = 'altanalyze3/snaf'
    author = 'SalomonisLab'
    description = 'Portable SNAF workflow with optional independent pyNeoQuant integration'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.04.8'
    version = '0.2.0'
}
params {
    input = null
    mode = 'ts'
    gtf = null
    hla = null
    infer_hla = false
    hla_require_all = false
    hla_min_depth = 8
    genome_build = 'auto'
    strandness = 'auto'
    novel_gene_mode = 'corrected'
    stop_after_counts = false
    min_reads = 20
    control_h5ad = null
    db_dir = null
    genome_fasta = null
    canonical_fasta = null
    mhcflurry_models = null
    binding_method = 'MHCflurry'
    netmhcpan_path = null
    validation_gtf = null
    isoform_method = 'learned'
    isoform_ranker = null
    first_exon_junctions = null
    with_pyneoquant = false
    ms_input = null
    search_format = 'generic'
    ms_q_threshold = 0.01
    outdir = 'results'
    // Local build tags. Override with immutable registry tags/digests after publishing.
    container = 'altanalyze3-snaf:0.1.3'
    pyneoquant_container = 'pyneoquant:0.1.0a1'
    max_cpus = 16
    max_memory = '128.GB'
    max_time = '48.h'
}
process {
    container = params.container
    cpus = 1
    memory = { 4.GB * task.attempt }
    time = { 2.h * task.attempt }
    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time]
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143] ? 'retry' : 'terminate' }
    maxRetries = 2
    withLabel:process_medium {
        cpus = 2
        memory = { 8.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withLabel:process_high {
        cpus = 4
        memory = { 32.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    publishDir = [path: { "${params.outdir}/${task.process.tokenize(':').last().toLowerCase()}" }, mode: 'copy']
    withName:SNAF_TS { ext.args = '--methods mle' }
}
profiles {
    local { process.executor = 'local' }
    docker { docker.enabled = true }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
    test { includeConfig 'conf/test.config' }
}
trace { enabled = true; file = "${params.outdir}/execution_trace.tsv" }
report { enabled = true; file = "${params.outdir}/execution_report.html" }
timeline { enabled = true; file = "${params.outdir}/execution_timeline.html" }
dag { enabled = true; file = "${params.outdir}/pipeline_dag.html" }
