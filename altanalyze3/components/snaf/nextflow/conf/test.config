// Minimal test profile for the SNAF tumor-specificity workflow.
// Point control_h5ad at a small normal-tissue h5ad and provide a samplesheet.
params {
    mode         = 'ts'
    input        = "${projectDir}/assets/samplesheet_test.csv"
    control_h5ad = null   // set on the command line: --control_h5ad <small_gtex_slice.h5ad>
    outdir       = 'results_test'
}

process {
    resourceLimits = [ cpus: 2, memory: '6.GB', time: '2.h' ]
    withName:SNAF_TS { ext.args = '--methods mle bayesian --bayes_epoch 400' }
}
