<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ app_title }}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/modern-normalize@3.0.1/modern-normalize.min.css">
    <link rel="stylesheet" href="{{ url_for('static', path='styles.css') }}?v={{ styles_version }}">
    <script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
    <script src="https://unpkg.com/cytoscape@3.30.4/dist/cytoscape.min.js"></script>
  </head>
  <body>
    <div class="explorer-shell compact-shell">
      <header class="hero compact-hero">
        <div class="hero-copy">
          <div class="hero-brand">
            <div>
              <p class="eyebrow">ULTRA-FAST SINGLE-CELL WORKFLOW <span class="eyebrow-subtitle">Powered by AltAnalyze3</span></p>
              <h1>scALABLE</h1>
            </div>
          </div>
          <p class="lede">Align single-cell data to a reference, explore results and perform comprehensive comparisons between groups</p>
        </div>
        <div class="workspace-tabs hero-centered-tabs" id="explorer-tabs">
          <button class="workspace-tab-btn active" type="button" data-tab="run">Run</button>
          <button class="workspace-tab-btn" type="button" data-tab="explore">Explore</button>
          <button class="workspace-tab-btn" type="button" data-tab="differential">Differential</button>
          <button class="workspace-tab-btn" type="button" data-tab="chat">Chat</button>
        </div>
        <div class="hero-links">
          <a class="docs-link" href="https://github.com/SalomonisLab/altanalyze3/blob/master/altanalyze3/components/cellHarmony/webapp/HOW_TO_USE.md" target="_blank" rel="noopener">How to Use</a>
          <a class="docs-link" href="https://github.com/SalomonisLab/altanalyze3/blob/master/altanalyze3/components/cellHarmony/webapp/README.md" target="_blank" rel="noopener">ReadMe</a>
          <button class="docs-link hidden" id="reset-data-btn" type="button">Reset data</button>
        </div>
      </header>

      <main class="sandbox-main">
        <section class="workspace-panel active" data-tab-panel="run">
          <section class="grid sandbox-run-grid preupload-mode" id="sandbox-run-grid">
            <section class="panel" id="upload-panel">
              <h2>1. Upload</h2>
              <form id="job-form">
                <label class="field">
                  <span>Species</span>
                  <select id="species-select" required></select>
                </label>
                <label class="field">
                  <span>Reference</span>
                  <select id="reference-select" required></select>
                </label>
                <div class="field sample-field">
                  <div class="field-row">
                    <span>Samples</span>
                    <button type="button" class="ghost-btn" id="add-sample-btn">Add sample</button>
                  </div>
                  <div id="sample-container"></div>
                </div>
                <input id="upload-job-id" type="hidden">
                <button class="primary-btn" id="upload-submit-btn" type="submit">Upload</button>
                <div class="progress-shell hidden" id="upload-progress-shell">
                  <div class="progress-track"><div class="progress-fill" id="upload-progress"></div></div>
                  <div class="progress-label" id="upload-progress-label">0%</div>
                </div>
                <div class="notice hidden" id="upload-job-id-display"></div>
              </form>
            </section>

            <section class="panel hidden" id="qc-panel">
              <h2>2. QC and alignment</h2>
              <form id="qc-form">
                <input id="qc-job-id" name="job_id" type="hidden" required>
                <div class="two-col">
                  <label class="field">
                    <span>Min genes</span>
                    <input name="min_genes" value="500">
                  </label>
                  <label class="field">
                    <span>Min counts</span>
                    <input name="min_counts" value="1000">
                  </label>
                </div>
                <div class="two-col">
                  <label class="field">
                    <span>Min cells</span>
                    <input name="min_cells" value="0">
                  </label>
                  <label class="field">
                    <span>Mito %</span>
                    <input name="mit_percent" value="15">
                  </label>
                </div>
                <div class="two-col">
                  <label class="field">
                    <span>Minimum cosine similarity score</span>
                    <input name="align_cutoff" value="0.4">
                  </label>
                  <label class="field">
                    <span>Ambient RNA correction</span>
                    <select name="ambient_correction">
                      <option value="no" selected>No</option>
                      <option value="yes">Yes</option>
                    </select>
                  </label>
                </div>
                <div class="two-col">
                  <label class="field hidden" id="qc-impute-modality-field">
                    <span>Impute modality</span>
                    <select name="impute_modality" id="qc-impute-modality-select">
                      <option value="none" selected>None</option>
                      <option value="all">All available</option>
                      <option value="lipids">Lipids</option>
                      <option value="adt">ADT (CITE-seq)</option>
                      <option value="metabolite">Metabolite (AML)</option>
                      <option value="lipid">Lipid (AML)</option>
                      <option value="grn">GRN (TF activity)</option>
                    </select>
                  </label>
                </div>
                <button class="primary-btn" type="submit">Save QC and run</button>
              </form>
              <div class="progress-shell">
                <div class="progress-track"><div class="progress-fill" id="job-progress"></div></div>
                <div class="progress-label" id="job-progress-label">0%</div>
              </div>
              <div class="notice" id="qc-cell-status">QC cell counts will appear here while the analysis runs.</div>
              <pre class="log-view" id="job-log"></pre>
            </section>

            <section class="panel hidden" id="qc-live-panel">
              <div class="panel-head">
                <h2>QC filter progress</h2>
              </div>
              <div id="ambient-live-plot" class="plot-area ambient-plot-area"></div>
              <div class="plot-caption" id="ambient-live-caption">Ambient RNA correction percentages will appear here when correction is performed.</div>
              <div id="qc-live-plot" class="plot-area"></div>
              <div class="plot-caption" id="qc-live-caption">Live counts parsed from alignment log.</div>
            </section>

            <section class="panel sandbox-preview-panel" id="reference-preview-panel">
              <div class="panel-head">
                <h2>Reference Preview</h2>
              </div>
              <div id="reference-preview-plot" class="plot-area"></div>
            </section>
          </section>
        </section>

        <section class="workspace-panel" data-tab-panel="explore">
          <div class="explore-workspace">
            <section class="panel explore-controls-panel hidden" id="explore-controls-panel">
              <h2>3. Results</h2>
              <form id="results-form">
                <input id="results-job-id" type="hidden">
                <datalist id="viz1-feature-suggestions"></datalist>
                <datalist id="viz2-feature-suggestions"></datalist>
                <label class="field">
                  <span>Dot size</span>
                  <select id="plot-dot-scale" name="plot_dot_scale">
                    <option value="0.25">0.25</option>
                    <option value="0.5" selected>0.5</option>
                    <option value="0.75">0.75</option>
                    <option value="1">1</option>
                  </select>
                </label>
              </form>
              <div class="downloads" id="download-links"></div>
            </section>

            <section class="explore-results-column">
              <section class="plots hidden" id="baseline-results-view">
                <article class="panel">
                  <div class="panel-head panel-head-column">
                    <div class="panel-head-topline">
                      <h2>Visualization Panel 1</h2>
                      <!-- Window count. Two equal columns give a plot that spans every cell state
                           only half the page. Choosing 1 hides panel 2 and lets this one use the
                           full width; panel 2 keeps its state while hidden. -->
                      <label class="inline-field compact-inline-field" id="viz-window-count-field">
                        <span>Windows</span>
                        <select id="viz-window-count" class="compact-select">
                          <option value="2" selected>2</option>
                          <option value="1">1</option>
                        </select>
                      </label>
                      <button class="ghost-btn" type="button" id="download-viz1-image-btn">Download PDF</button>
                    </div>
                    <div class="panel-head-stack viz-controls-grid">
                      <label class="field inline-field compact-inline-field">
                        <span>Select plot type</span>
                        <select id="viz1-mode" class="compact-select">
                          <option value="relative">UMAP broad</option>
                          <option value="cluster" selected>UMAP cell types</option>
                          <option value="frequency">Cell frequency</option>
                          <option value="expression_umap">UMAP</option>
                          <option value="violin">Violin</option>
                        </select>
                      </label>
                      <label class="field hidden inline-field compact-inline-field" id="viz1-modality-field">
                        <span>Modality</span>
                        <select id="viz1-modality" class="compact-select"></select>
                      </label>
                      <!-- Color by. The UMAP cell-type view colours each cell by its
                           cellHarmony assignment. Any other categorical column of obs
                           works as well, so an atlas annotation the uploaded h5ad
                           already carries can be drawn instead. -->
                      <label class="field hidden inline-field compact-inline-field" id="viz1-colorby-field">
                        <span>Color by</span>
                        <select id="viz1-colorby" class="compact-select"></select>
                      </label>
                      <!-- Coordinates. Any 2-D embedding in obsm can replace the
                           cellHarmony projection. The reference atlas holds different
                           coordinates, so the app hides it while another embedding or
                           another colour column is selected. -->
                      <label class="field hidden inline-field compact-inline-field" id="viz1-coords-field">
                        <span>Coordinates</span>
                        <select id="viz1-coords" class="compact-select"></select>
                      </label>
                      <!-- Axes. Choosing "obs columns" in Coordinates puts any two
                           numeric cell annotations on the axes, the way ShinyCell
                           plots one metadata field against another. Counts live in
                           the matrix, not in obs, so nothing here is expression. -->
                      <label class="field hidden inline-field compact-inline-field" id="viz1-xfield-field">
                        <span>Coordinates X</span>
                        <select id="viz1-xfield" class="compact-select"></select>
                      </label>
                      <label class="field hidden inline-field compact-inline-field" id="viz1-yfield-field">
                        <span>Coordinates Y</span>
                        <select id="viz1-yfield" class="compact-select"></select>
                      </label>
                      <!-- Group by. The DotPlot and CombPlot lay their columns out along this
                           variable. Cell state is the default; choosing another shows that
                           variable in place of cell states. Only variables with a workable
                           number of levels are offered. -->
                      <label class="field hidden inline-field compact-inline-field" id="viz1-groupby-field">
                        <span>Group by</span>
                        <select id="viz1-groupby" class="compact-select"></select>
                      </label>
                      <!-- Which levels to show. Multiple may be selected. -->
                      <label class="field hidden inline-field compact-inline-field" id="viz1-groups-field">
                        <span>Show</span>
                        <select id="viz1-groups" class="compact-select" multiple size="3"></select>
                      </label>
                      <!-- Gene set. DotPlot and CombPlot take a list of genes, not one symbol.
                           A column pasted out of a spreadsheet arrives newline separated, which a
                           one-line input flattens out of sight. -->
                      <label class="field hidden inline-field compact-inline-field" id="viz1-geneset-field">
                        <span>Gene set</span>
                        <textarea id="viz1-geneset" rows="3" spellcheck="false"
                          placeholder="paste a gene list &#8212; Excel column, comma, space or newline"></textarea>
                      </label>
                      <!-- CombPlot only: a donor contributing one cell to a state yields a mean
                           from that single cell, which draws as a tall bar built on nothing. -->
                      <label class="field hidden inline-field compact-inline-field" id="viz1-combmin-field">
                        <span>Min cells</span>
                        <select id="viz1-combmin" class="compact-select">
                          <option value="1">1</option>
                          <option value="5" selected>5</option>
                          <option value="10">10</option>
                          <option value="25">25</option>
                        </select>
                      </label>
                      <label class="field inline-field compact-inline-field" id="viz1-gene-field">
                        <span>Select molecule</span>
                        <input id="viz1-gene-query" placeholder="e.g. MPO" list="viz1-feature-suggestions">
                      </label>
                      <label class="field hidden inline-field" id="viz1-marker-population-field">
                        <span>Marker cell state</span>
                        <select id="viz1-marker-population"></select>
                      </label>
                      <label class="field hidden inline-field compact-inline-field" id="viz1-grn-genes-field">
                        <span>GRN genes</span>
                        <input id="viz1-grn-genes" placeholder="e.g. GATA1, SPI1" list="viz1-feature-suggestions">
                      </label>
                      <label class="field hidden inline-field compact-inline-field" id="viz1-grn-sample-field">
                        <span>Sample</span>
                        <select id="viz1-grn-sample" class="compact-select"></select>
                      </label>
                      <label class="field hidden inline-field compact-inline-field" id="viz1-grn-cellstate-field">
                        <span>Cell type</span>
                        <select id="viz1-grn-cellstate" class="compact-select"></select>
                      </label>
                      <label class="field hidden inline-field compact-inline-field" id="viz1-grn-threshold-field">
                        <span>Edge |score| &ge; <span id="viz1-grn-threshold-value">0.000</span></span>
                        <input id="viz1-grn-threshold" type="range" min="0" max="0.3" step="0.002" value="0">
                      </label>
                    </div>
                    <div class="stack viz-filter-stack" id="viz1-filter-stack">
                      <span class="field-group-label">Filter data to display</span>
                      <div class="display-filter-grid">
                        <label class="field compact-field">
                          <span>Annotation 1</span>
                          <select id="viz1-filter1-field"></select>
                        </label>
                        <label class="field compact-field">
                          <span>Values</span>
                          <select id="viz1-filter1-values"></select>
                        </label>
                      </div>
                      <div class="display-filter-grid" id="viz1-filter-secondary-row">
                        <label class="field compact-field">
                          <span>Annotation 2</span>
                          <select id="viz1-filter2-field"></select>
                        </label>
                        <label class="field compact-field">
                          <span>Values</span>
                          <select id="viz1-filter2-values"></select>
                        </label>
                      </div>
                    </div>
                  </div>
                  <div id="viz1-plot" class="plot-area"></div>
                  <div class="plot-caption" id="viz1-filter-summary"></div>
                </article>
                <article class="panel">
                  <div class="panel-head panel-head-column">
                    <div class="panel-head-topline">
                      <h2>Visualization Panel 2</h2>
                      <button class="ghost-btn" type="button" id="download-viz2-image-btn">Download PDF</button>
                    </div>
                    <div class="panel-head-stack viz-controls-grid">
                      <label class="field inline-field compact-inline-field">
                        <span>Select plot type</span>
                        <select id="viz2-mode" class="compact-select">
                          <option value="relative">UMAP broad</option>
                          <option value="cluster">UMAP cell types</option>
                          <option value="frequency">Cell frequency</option>
                          <option value="expression_umap" selected>UMAP</option>
                          <option value="violin">Violin</option>
                        </select>
                      </label>
                      <label class="field hidden inline-field compact-inline-field" id="viz2-modality-field">
                        <span>Modality</span>
                        <select id="viz2-modality" class="compact-select"></select>
                      </label>
                      <!-- Color by. The UMAP cell-type view colours each cell by its
                           cellHarmony assignment. Any other categorical column of obs
                           works as well, so an atlas annotation the uploaded h5ad
                           already carries can be drawn instead. -->
                      <label class="field hidden inline-field compact-inline-field" id="viz2-colorby-field">
                        <span>Color by</span>
                        <select id="viz2-colorby" class="compact-select"></select>
                      </label>
                      <!-- Coordinates. Any 2-D embedding in obsm can replace the
                           cellHarmony projection. The reference atlas holds different
                           coordinates, so the app hides it while another embedding or
                           another colour column is selected. -->
                      <label class="field hidden inline-field compact-inline-field" id="viz2-coords-field">
                        <span>Coordinates</span>
                        <select id="viz2-coords" class="compact-select"></select>
                      </label>
                      <!-- Axes. Choosing "obs columns" in Coordinates puts any two
                           numeric cell annotations on the axes, the way ShinyCell
                           plots one metadata field against another. Counts live in
                           the matrix, not in obs, so nothing here is expression. -->
                      <label class="field hidden inline-field compact-inline-field" id="viz2-xfield-field">
                        <span>Coordinates X</span>
                        <select id="viz2-xfield" class="compact-select"></select>
                      </label>
                      <label class="field hidden inline-field compact-inline-field" id="viz2-yfield-field">
                        <span>Coordinates Y</span>
                        <select id="viz2-yfield" class="compact-select"></select>
                      </label>
                      <!-- Group by. The DotPlot and CombPlot lay their columns out along this
                           variable. Cell state is the default; choosing another shows that
                           variable in place of cell states. Only variables with a workable
                           number of levels are offered. -->
                      <label class="field hidden inline-field compact-inline-field" id="viz2-groupby-field">
                        <span>Group by</span>
                        <select id="viz2-groupby" class="compact-select"></select>
                      </label>
                      <!-- Which levels to show. Multiple may be selected. -->
                      <label class="field hidden inline-field compact-inline-field" id="viz2-groups-field">
                        <span>Show</span>
                        <select id="viz2-groups" class="compact-select" multiple size="3"></select>
                      </label>
                      <!-- Gene set. DotPlot and CombPlot take a list of genes, not one symbol.
                           A column pasted out of a spreadsheet arrives newline separated, which a
                           one-line input flattens out of sight. -->
                      <label class="field hidden inline-field compact-inline-field" id="viz2-geneset-field">
                        <span>Gene set</span>
                        <textarea id="viz2-geneset" rows="3" spellcheck="false"
                          placeholder="paste a gene list &#8212; Excel column, comma, space or newline"></textarea>
                      </label>
                      <!-- CombPlot only: a donor contributing one cell to a state yields a mean
                           from that single cell, which draws as a tall bar built on nothing. -->
                      <label class="field hidden inline-field compact-inline-field" id="viz2-combmin-field">
                        <span>Min cells</span>
                        <select id="viz2-combmin" class="compact-select">
                          <option value="1">1</option>
                          <option value="5" selected>5</option>
                          <option value="10">10</option>
                          <option value="25">25</option>
                        </select>
                      </label>
                      <label class="field inline-field compact-inline-field" id="viz2-gene-field">
                        <span>Select molecule</span>
                        <input id="viz2-gene-query" placeholder="e.g. MPO" list="viz2-feature-suggestions">
                      </label>
                      <label class="field hidden inline-field" id="viz2-marker-population-field">
                        <span>Marker cell state</span>
                        <select id="viz2-marker-population"></select>
                      </label>
                      <label class="field hidden inline-field compact-inline-field" id="viz2-grn-genes-field">
                        <span>GRN genes</span>
                        <input id="viz2-grn-genes" placeholder="e.g. GATA1, SPI1" list="viz2-feature-suggestions">
                      </label>
                      <label class="field hidden inline-field compact-inline-field" id="viz2-grn-sample-field">
                        <span>Sample</span>
                        <select id="viz2-grn-sample" class="compact-select"></select>
                      </label>
                      <label class="field hidden inline-field compact-inline-field" id="viz2-grn-cellstate-field">
                        <span>Cell type</span>
                        <select id="viz2-grn-cellstate" class="compact-select"></select>
                      </label>
                      <label class="field hidden inline-field compact-inline-field" id="viz2-grn-threshold-field">
                        <span>Edge |score| &ge; <span id="viz2-grn-threshold-value">0.000</span></span>
                        <input id="viz2-grn-threshold" type="range" min="0" max="0.3" step="0.002" value="0">
                      </label>
                    </div>
                    <div class="stack viz-filter-stack" id="viz2-filter-stack">
                      <span class="field-group-label">Filter data to display</span>
                      <div class="display-filter-grid">
                        <label class="field compact-field">
                          <span>Annotation 1</span>
                          <select id="viz2-filter1-field"></select>
                        </label>
                        <label class="field compact-field">
                          <span>Values</span>
                          <select id="viz2-filter1-values"></select>
                        </label>
                      </div>
                      <div class="display-filter-grid" id="viz2-filter-secondary-row">
                        <label class="field compact-field">
                          <span>Annotation 2</span>
                          <select id="viz2-filter2-field"></select>
                        </label>
                        <label class="field compact-field">
                          <span>Values</span>
                          <select id="viz2-filter2-values"></select>
                        </label>
                      </div>
                    </div>
                  </div>
                  <div id="viz2-plot" class="plot-area"></div>
                  <div class="plot-caption" id="viz2-filter-summary"></div>
                </article>
              </section>
            </section>
          </div>
        </section>

        <section class="workspace-panel" data-tab-panel="differential">
          <div class="differential-workspace">
            <section class="panel differential-controls-panel hidden" id="differential-panel">
              <h2>DIFFERENTIAL ANALYSIS</h2>
              <p class="panel-copy" id="differential-intro">Perform cell-state differential expression.</p>
              <form id="differential-form">
                <!-- Cell state and Modality sit on SEPARATE rows. Sharing one row cut
                     both selects to half width, and the cell-state names are long enough
                     that the text clipped. -->
                <div class="one-col">
                  <label class="field">
                    <span>Cell-state aligned to</span>
                    <select id="differential-population" required></select>
                  </label>
                </div>
                <div class="one-col">
                  <label class="field hidden" id="differential-modality-field">
                    <span>Modality</span>
                    <select id="differential-modality"></select>
                  </label>
                </div>
                <div class="two-col">
                  <label class="field">
                    <span>Group values from</span>
                    <select id="differential-sample-field" required></select>
                  </label>
                </div>
                <label class="field hidden" id="differential-comparison-type-field">
                  <span>Comparison Type</span>
                  <select id="differential-comparison-type">
                    <option value="cells">cells</option>
                    <option value="pseudobulk">pseudobulk</option>
                  </select>
                </label>
                <div class="two-col">
                  <label class="field">
                    <span class="differential-group-label">Group 1 (numerator)</span>
                    <select id="differential-group1" multiple size="4" required></select>
                  </label>
                  <label class="field">
                    <span class="differential-group-label">Group 2 (denominator)</span>
                    <select id="differential-group2" multiple size="4" required></select>
                  </label>
                </div>
                <button class="primary-btn" type="submit" id="differential-run-btn">Run cellHarmony-differential</button>
              </form>
              <div class="progress-shell">
                <div class="progress-track"><div class="progress-fill" id="differential-progress"></div></div>
                <div class="progress-label" id="differential-progress-label">0%</div>
              </div>
              <div class="notice" id="differential-message">
                Differential analysis is enabled when the job contains two or more samples.
              </div>
              <a class="download-btn hidden" id="differential-archive-link" href="#" target="_blank" rel="noopener">Download differential ZIP</a>
              <!-- "Download log" removed 2026-09-02: a precomputed bundle carries no run
                   log for a reader to fetch. The element stays so the code that toggles
                   it keeps working, but it never shows. -->
              <a class="download-btn hidden" id="differential-log-link" href="#" target="_blank" rel="noopener" hidden style="display:none">Download log</a>
            </section>

            <section class="differential-results-column">
              <section class="plots hidden differential-plots" id="differential-results-view">
                <article class="panel differential-primary-panel">
                  <div class="panel-head">
                    <h2>Differential Explorer</h2>
                    <div class="differential-head-actions">
                      <div class="differential-head-row">
                        <select id="differential-viz-mode" class="compact-select">
                          <option value="summary">Differential counts</option>
                          <option value="heatmap">Heatmap</option>
                          <option value="volcano">Volcano</option>
                          <option value="network">Network</option>
                          <option value="go">GO Terms</option>
                        </select>
                        <select id="differential-result-population" class="compact-select"></select>
                        <input
                          id="differential-gene-filter"
                          class="compact-input"
                          type="search"
                          list="differential-gene-filter-options"
                          autocomplete="off"
                          spellcheck="false"
                          placeholder="Filter by gene"
                          aria-label="Filter the differential view to one gene and the genes it interacts with"
                        />
                        <datalist id="differential-gene-filter-options"></datalist>
                      </div>
                      <div class="differential-head-row differential-filter-note hidden" id="differential-gene-filter-note"></div>
                      <div class="differential-head-row differential-head-download-row">
                      <a class="ghost-btn hidden" id="download-differential-left-btn" href="#" target="_blank" rel="noopener">Download PDF</a>
                      </div>
                    </div>
                  </div>
                  <div class="interactive-plot-shell">
                    <div id="differential-plot-area" class="interactive-plot-area hidden"></div>
                    <div class="empty-state" id="differential-plot-empty">
                      Run cellHarmony-differential to explore the integrated heatmap, volcano plot, network, or GO terms.
                    </div>
                  </div>
                </article>
                <article class="panel differential-secondary-panel">
                  <div class="panel-head">
                    <h2 id="differential-detail-title">Gene Detail</h2>
                    <div class="panel-head-actions">
                      <div class="selected-gene-label" id="differential-selected-gene">Select a gene from the left panel.</div>
                      <div class="lr-toggle hidden" id="differential-lr-toggle" role="group" aria-label="Show expression of ligand or receptor">
                        <button type="button" class="lr-toggle-btn" data-lr-role="ligand">Ligand</button>
                        <button type="button" class="lr-toggle-btn" data-lr-role="receptor">Receptor</button>
                      </div>
                      <a class="ghost-btn hidden" id="download-differential-gene-btn" href="#" target="_blank" rel="noopener">Download PDF</a>
                    </div>
                  </div>
                  <div class="interactive-plot-shell gene-detail-shell">
                    <div id="differential-gene-plot" class="interactive-plot-area hidden"></div>
                    <div class="empty-state" id="differential-gene-empty">
                      Select a gene from the heatmap, volcano plot, network, or GO terms to compare expression between groups.
                    </div>
                  </div>
                  <div class="gene-stats hidden" id="differential-gene-stats"></div>
                </article>
              </section>
              <div class="empty-state explorer-empty" id="differential-tab-empty">
                Differential gene analyses between biological groups (i.e., disease versus controls) are only enabled when two or more samples (multiple h5 files or a single h5ad) are uploaded for the job.
              </div>
            </section>
          </div>
        </section>
        <!-- Chat. The question is read by the LungMAP assistant, which never sees the
             data; every number below comes from this job. See app.py /chat. -->
        <section class="workspace-panel" data-tab-panel="chat">
          <article class="panel">
            <div class="panel-head"><h2>Ask about this dataset</h2></div>
            <p class="panel-copy">
              Ask a research question about this dataset. Every number below is computed
              from the data; the model only decides which analysis to run, so it cannot
              invent a fold change. A question it has no recipe for is refused, and an
              analysis that lives in another tab is named rather than reprinted.
            </p>
            <div class="chat-ask">
              <textarea id="chat-question" rows="2"
                placeholder="Load a dataset to see example questions"></textarea>
              <button class="primary-btn" type="button" id="chat-send">Ask</button>
            </div>
            <!-- The examples name this job's own reference and cell states, so a
                 bone-marrow job never offers a lung question. app.js fills them from
                 /api/jobs/{id}/chat-examples when the results load. -->
            <div class="chat-examples" id="chat-examples">
              <span>Try:</span>
            </div>
            <p class="panel-copy" id="chat-status"></p>
            <div id="chat-answer"></div>
            <div class="chat-examples" id="chat-followups"></div>
            <div class="chat-views hidden" id="chat-views">
              <button type="button" class="ghost-btn active" data-view="table">Table</button>
              <button type="button" class="ghost-btn" data-view="plot">Plot</button>
            </div>
            <div id="chat-table"></div>
            <div id="chat-plot" class="hidden"></div>
          </article>
        </section>
      </main>
    </div>

    <script>
      window.__APP_ROOT_PATH__ = {{ app_root_path | tojson }};
      window.__REFERENCE_REGISTRY__ = {{ registry_json | safe }};
    </script>
    <script src="{{ url_for('static', path='app.js') }}?v={{ app_js_version }}"></script>
</body>
</html>
