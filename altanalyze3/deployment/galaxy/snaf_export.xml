<tool id="altanalyze3_snaf_export" name="SNAF export" version="0.1.3" profile="24.0">
    <description>candidate FASTA and source manifest for optional proteomics analysis</description>
    <requirements><container type="docker">altanalyze3-snaf:0.1.3</container></requirements>
    <command detect_errors="exit_code"><![CDATA[
python3 -m altanalyze3.components.neoantigen export --candidates '$candidates' --outdir bundle --predictor '$predictor'
    ]]></command>
    <inputs>
        <param name="candidates" type="data" format="tabular" label="SNAF candidate table"/>
        <param name="predictor" type="select" label="Binding predictor used">
            <option value="MHCflurry">MHCflurry</option><option value="netMHCpan">NetMHCpan</option>
        </param>
    </inputs>
    <outputs>
        <data name="fasta" format="fasta" from_work_dir="bundle/candidates.fasta" label="Candidate peptides"/>
        <data name="manifest" format="tabular" from_work_dir="bundle/source_manifest.tsv" label="Source manifest"/>
        <data name="normalized" format="tabular" from_work_dir="bundle/candidates.tsv" label="Normalized candidates"/>
        <data name="provenance" format="json" from_work_dir="bundle/export_manifest.json" label="Export provenance"/>
    </outputs>
    <tests>
        <test><param name="candidates" value="candidates.tsv"/><param name="predictor" value="MHCflurry"/>
            <output name="fasta"><assert_contents><has_text text="PEPTIDE"/></assert_contents></output>
            <output name="manifest"><assert_contents><has_text text="ENSG1:E1-E3"/></assert_contents></output>
        </test>
    </tests>
    <help>Export SNAF peptide candidates with stable source identifiers. The independent pyNeoQuant library is optional. This export describes reported candidate peptides; it does not infer protein structure or validate HLA presentation.</help>
    <citations><citation type="doi">10.1126/scitranslmed.ade2886</citation></citations>
</tool>
