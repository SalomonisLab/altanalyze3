<tool id="altanalyze3_snaf_filter" name="SNAF junction filter" version="0.1.3" profile="24.0">
    <description>retain junctions meeting the read threshold in any sample</description>
    <requirements><container type="docker">altanalyze3-snaf:0.1.3</container></requirements>
    <command detect_errors="exit_code"><![CDATA[
python3 -m altanalyze3.components.neoantigen filter --counts '$counts' --output filtered.tsv --min-reads $min_reads
    ]]></command>
    <inputs>
        <param name="counts" type="data" format="tabular" label="Junction count matrix"/>
        <param name="min_reads" type="integer" value="20" min="0" label="Minimum reads in any sample"/>
    </inputs>
    <outputs><data name="filtered" label="Filtered junctions" format="tabular" from_work_dir="filtered.tsv"/><data name="summary" label="Filter summary" format="json" from_work_dir="filtered.tsv.json"/></outputs>
    <tests><test><param name="counts" value="counts.tsv"/><output name="filtered" file="filtered.tsv"/></test></tests>
    <help>Retains rows where at least one sample has a count greater than or equal to the threshold. Columns after the junction identifier must contain nonnegative finite counts.</help>
    <citations><citation type="doi">10.1126/scitranslmed.ade2886</citation></citations>
</tool>
