altanalyze3/components/fastComm/benchmarks/
altanalyze3/components/fastComm/models/

# Required immutable fastComm ligand-receptor resources for scALABLE deployments.
!altanalyze3/components/fastComm/resources/
!altanalyze3/components/fastComm/resources/cellchat_nichenet_human/
!altanalyze3/components/fastComm/resources/cellchat_nichenet_mouse/
!altanalyze3/components/fastComm/resources/cellchat_nichenet_human/ligand_receptor.tsv
!altanalyze3/components/fastComm/resources/cellchat_nichenet_human/manifest.json
!altanalyze3/components/fastComm/resources/cellchat_nichenet_mouse/ligand_receptor.tsv
!altanalyze3/components/fastComm/resources/cellchat_nichenet_mouse/manifest.json

# Per-component artifacts/ folders. Each component owns a single artifacts/
# directory used for intermediate benchmark outputs, scratch evaluation
# TSVs, trained-bundle scratch space, etc. Not tracked. rna2adt/artifacts
# alone holds 394,734,099 bytes in 94 files.
#
# The pattern ends in /* rather than /, because git cannot re-include a file
# whose parent DIRECTORY is excluded. The exceptions below are the bundles a
# deployed service loads at run time: a container built from this repository
# has no other copy, and imputation fails with FileNotFoundError without them.
altanalyze3/components/*/artifacts/*
!altanalyze3/components/rna2metabolite/artifacts/rna2metabolite_aml_bundle.pkl.gz
!altanalyze3/components/rna2metabolite/artifacts/rna2metabolite_aml_NA30_20261006_bundle.pkl.gz
!altanalyze3/components/rna2psi/artifacts/rna2psi_leucegene_focused.pkl.gz
!altanalyze3/components/rna2psi/artifacts/rna2psi_reclassifiers.pkl.gz

# rna2adt: trained bundle bytes (~190 KB to ~55 MB each, many variants) are
# regenerable from training scripts. Track adt_rna_map.py / build_whitelist.py
# / configs/*.tsv; ignore the .pkl bundles and per-ADT metrics TSVs.
altanalyze3/components/rna2adt/mouse/rna2adt_mm_per_adt_metrics.tsv

# rna2lipid: same pattern (large pickled bundles regenerable from training).
# The lung bundle is the exception: api.py:28 loads it as DEFAULT_BUNDLE_PATH,
# so lipid imputation cannot run in a container without it.
altanalyze3/components/rna2lipid/*.pkl
!altanalyze3/components/rna2lipid/rna2lipid_hs_lung_lipidwise_bundle.pkl
!altanalyze3/components/rna2lipid/rna2lipid_hs_lung_native_log2_20261005_bundle.pkl

# cellHarmony web app — per-user runtime job state. The local jobs/ tree
# can grow to many GB of test runs; never belongs in version control.
# (Repeats the broader 'jobs/' rule above for clarity.)
altanalyze3/components/cellHarmony/webapp/jobs/

# Daedalus training outputs — per-phase checkpoints, downloaded data,
# saved models, and run logs. data/ is ignored only under Daedalus
# (other components have small tracked reference data we want kept).
altanalyze3/components/Daedalus/phase_*/checkpoints/
altanalyze3/components/Daedalus/phase_*/data/
altanalyze3/components/Daedalus/phase_*/models/
altanalyze3/components/Daedalus/phase_*/logs/
altanalyze3/components/Daedalus/phase_*/lightning_logs/
altanalyze3/components/Daedalus/phase_*/wandb/

# Proteus large pretraining corpora.
altanalyze3/components/Proteus/data/

# iso2function: extracted/parsed interaction tables + crosswalk outputs (regenerable from the source
# supplementary zips via `iso2function ingest`/`crosswalk`) and any downloaded reference snapshots.
# artifacts/ is already covered by the components/*/artifacts/ rule above. resources/ stays TRACKED
# (small bundled lookups only).
altanalyze3/components/iso2function/data/
altanalyze3/components/iso2function/external/

# Miscellaneous scratch / runtime
altanalyze3/components/tests/logs/
tmp/
*.swp
# Ad-hoc tmp_* outputs (e.g. marker-heatmap test runs in cellHarmony/flask).
# Anything intentionally tracked should be renamed without the tmp_ prefix.
tmp_*
**/tmp_*

# Per-edit working backups created automatically by Claude. Each edit produces
# a timestamped copy under .edit-archive/<YYYYMMDD>/<HHMMSS>__<filename> with a
# matching log entry in .edit-archive/edits.log. Not tracked.
.edit-archive/

# Backup files
*.bak*

